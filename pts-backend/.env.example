# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# O arquivo ".env" NUNCA deve ser commitado no Git (contém senhas/tokens).

# --- E-mail (obrigatório para o botão "Enviar" com contato de e-mail) ---
# Exemplo usando Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_de_16_letras
SMTP_FROM=seuemail@gmail.com

# --- WhatsApp via Twilio (obrigatório para o botão "Enviar" com contato de WhatsApp) ---
# Crie uma conta gratuita em twilio.com/try-twilio e ative o Sandbox do WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- URL pública do servidor (necessária só para o Twilio buscar o PDF) ---
# Em desenvolvimento local, use um túnel do ngrok (ex: https://abcd1234.ngrok-free.app)
# Em produção, use o domínio real do servidor (ex: https://pts.suaempresa.com.br)
PUBLIC_BASE_URL=http://localhost:5000
